{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-maison-store",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
